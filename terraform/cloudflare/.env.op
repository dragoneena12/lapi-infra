# 1Password の参照先だけを書く（値そのものは書かない）
# op run --env-file=.env.op -- terraform <command>
CLOUDFLARE_API_TOKEN=op://lapi-server/cloudflare-terraform/credential
TF_VAR_cloudflare_account_id=op://lapi-server/cloudflare-terraform/account-id
# kemofest.tokyo のアカウント（tkf-harness）
TF_VAR_kemofest_cloudflare_api_token=op://lapi-server/cloudflare-terraform-kemofest/credential
TF_VAR_kemofest_cloudflare_account_id=op://lapi-server/cloudflare-terraform-kemofest/account-id
